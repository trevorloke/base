# --- Database ---
# Leave DATABASE_URL unset to use embedded PGlite at ./.pglite (dev/test).
# DATABASE_URL=postgres://user:pass@host:5432/starsign

# --- Redis (BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets ---
# 32-byte key, base64. Encrypts social account credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STARSIGN_MASTER_KEY=

# --- API ---
PORT=4000
# Dev convenience: when set, requests without a bearer key or session act as this workspace.
# STARSIGN_DEV_WORKSPACE=acme

# --- People (sign-in) ---
# The first person can always sign up. After that, sign-up is invite-only unless this is 1.
# STARSIGN_ALLOW_SIGNUP=1
# Invite and password-reset emails go through Resend when both are set; otherwise invite links are only
# returned to the owner and reset links are printed to the API log (outside production).
# RESEND_API_KEY=
# MAIL_FROM="Starsign <noreply@example.com>"

# --- Claude ---
# ANTHROPIC_API_KEY=
STARSIGN_MODEL=claude-opus-5-5

# --- Connectors ---
# ZERNIO_API_KEY=
# ZERNIO_BASE_URL=https://api.zernio.com
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# --- Trend sources (the radar's eyes) ---
# Always on, no key: Google Trends "trending now" RSS, Wikipedia pageviews, Hacker News, Bluesky search, your own feed.
STARSIGN_TRENDS_REGION=US
# GOOGLE_TRENDS_API_KEY=          # official Google Trends API (alpha, invite only): interest over time per keyword
# YOUTUBE_API_KEY=                # YouTube Data API: most-popular chart per region
# STARSIGN_BLUESKY_SEARCH_TOKEN=  # only if the public Bluesky search starts requiring auth
# STARSIGN_SOURCES=hacker_news,wikipedia_pageviews   # limit which sources run
# STARSIGN_ENABLE_MOCK=1          # allow the mock connector in production (demos only)
# STARSIGN_FAKE_AI=1              # deterministic fake model for the API and operators (no network)

# --- Connecting accounts ---
# STARSIGN_PUBLIC_URL=https://starsign.example.com   # OAuth redirects return here (X callback: /oauth/x/callback)

# --- Network apps (see docs/integrations/README.md) ---
# X_CLIENT_ID= X_CLIENT_SECRET=
# META_CLIENT_ID= META_CLIENT_SECRET= META_WEBHOOK_VERIFY_TOKEN= META_LOGIN_CONFIG_ID=
# THREADS_CLIENT_ID= THREADS_CLIENT_SECRET= THREADS_WEBHOOK_VERIFY_TOKEN=
# LINKEDIN_CLIENT_ID= LINKEDIN_CLIENT_SECRET= LINKEDIN_SCOPES="openid profile email w_member_social"
# PINTEREST_CLIENT_ID= PINTEREST_CLIENT_SECRET=
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY= TIKTOK_CLIENT_SECRET=
# REDDIT_CLIENT_ID= REDDIT_CLIENT_SECRET= REDDIT_USER_AGENT="web:starsign:0.1 (by /u/yourname)"
# TELEGRAM_WEBHOOK_SECRET=

# --- Media storage (S3-compatible, e.g. Cloudflare R2). Without these, files go to STARSIGN_MEDIA_DIR on local disk. ---
# STARSIGN_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STARSIGN_S3_REGION=auto
# STARSIGN_S3_BUCKET=starsign-media
# STARSIGN_S3_ACCESS_KEY_ID=
# STARSIGN_S3_SECRET_ACCESS_KEY=
# STARSIGN_S3_PUBLIC_URL=https://media.example.com
# With S3 storage the web app uploads files straight to the bucket (up to 4 GB video). The bucket's CORS policy must
# allow PUT with a content-type header from the app's origin.

# --- Link tracking. Short links default to ${STARSIGN_PUBLIC_URL}/l when that URL is public; a short domain reads better. ---
# STARSIGN_LINK_BASE_URL=https://go.example.com

# Largest upload accepted, in MB. Uploads are held in memory: keep this well under the instance memory (default 100).
# STARSIGN_MAX_UPLOAD_MB=100
