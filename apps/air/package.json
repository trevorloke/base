{
  "name": "base-air",
  "private": true,
  "version": "0.1.0",
  "description": "base air — the system of record for attention. Observe every surface, forecast where attention is going, act through operators inside your red lines, prove what moved.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @base-air/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @base-air/api dev",
    "dev:workers": "pnpm --filter @base-air/workers dev",
    "dev:mcp": "pnpm --filter @base-air/mcp dev",
    "dev:web": "pnpm --filter @base-air/web dev",
    "dev:operators": "pnpm --filter @base-air/operators dev",
    "build:web": "pnpm --filter @base-air/web build",
    "seed": "pnpm --filter @base-air/api seed",
    "migrate": "pnpm --filter @base-air/db migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
