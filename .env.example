# --- Database ---
# Leave DATABASE_URL unset to use embedded PGlite at ./.pglite (dev/test).
# DATABASE_URL=postgres://user:pass@host:5432/meridian

# --- Redis (BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets ---
# 32-byte key, base64. Encrypts social account credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MERIDIAN_MASTER_KEY=

# --- API ---
PORT=4000
# Dev convenience: when set, requests without a bearer key act as this workspace.
# MERIDIAN_DEV_WORKSPACE=acme

# --- Claude ---
# ANTHROPIC_API_KEY=
MERIDIAN_MODEL=claude-opus-5-5

# --- Connectors ---
# ZERNIO_API_KEY=
# ZERNIO_BASE_URL=https://api.zernio.com
# X_CLIENT_ID=
# X_CLIENT_SECRET=
